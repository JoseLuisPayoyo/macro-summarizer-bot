# Copia este fichero a `.env` y rellena los valores. `.env` NO se sube al repo.

# --- Credenciales ---

# Token del bot, te lo da @BotFather en Telegram.
TELEGRAM_TOKEN=

# Clave de OpenRouter (https://openrouter.ai/keys). Por aquí van todas las llamadas a LLM.
OPENROUTER_API_KEY=

# Clave de Groq (https://console.groq.com/keys). OPCIONAL: solo hace falta para el plan B,
# transcribir el audio con Whisper cuando el vídeo no tiene subtítulos. Si la dejas vacía,
# el bot avisará de que no puede resumir vídeos sin subtítulos.
GROQ_API_KEY=

# --- Modelos ---
# Los IDs de modelo se copian tal cual de https://openrouter.ai/models
# (el ID es la cadena "autor/modelo" que aparece en la ficha de cada modelo).

# Paso "map": una llamada por bloque de ~10 min. Usa un modelo BARATO: es el que domina
# el coste del vídeo (una charla de 2 h son ~12 llamadas).
MAP_MODEL=deepseek/deepseek-v4-flash

# Paso "reduce": una única llamada final que sintetiza el resumen. Usa un modelo MEJOR:
# se llama una sola vez, así que apenas afecta al coste total.
REDUCE_MODEL=anthropic/claude-sonnet-4

# Precios en USD por MILLÓN de tokens, copiados de la ficha de cada modelo en
# openrouter.ai/models. OPCIONALES: solo sirven para el coste estimado que el bot añade
# al pie del informe; si falta alguno, el pie omite el coste (no se inventa).
MAP_INPUT_USD_PER_MTOK=
MAP_OUTPUT_USD_PER_MTOK=
REDUCE_INPUT_USD_PER_MTOK=
REDUCE_OUTPUT_USD_PER_MTOK=

# --- Control de acceso ---

# IDs numéricos de Telegram autorizados a usar el bot, separados por comas. Para saber tu
# ID, escríbele a @userinfobot en Telegram y te lo dirá. El bot es descubrible por su
# @usuario, así que sin esta lista cualquiera podría gastar tu crédito de OpenRouter.
# VACÍO = el bot RECHAZA A TODO EL MUNDO (falla cerrado); rellénalo con al menos tu ID.
ALLOWED_USER_IDS=

# --- Comportamiento del resumen ---

# Idioma del resumen que recibe el usuario.
SUMMARY_LANG=es

# Tamaño de la ventana de troceo de la transcripción, en minutos.
CHUNK_MINUTES=10

# Máximo de llamadas map simultáneas contra OpenRouter (para no chocar con sus límites).
MAX_CONCURRENCY=5

# Bloques del informe que se agrupan en un mismo mensaje de Telegram. Un vídeo de 2 h da
# ~12 bloques; agruparlos evita un chat interminable, SIN tocar el troceo del map (que es
# quien da la calidad). Agrupar más = menos mensajes, pero cada uno más largo.
BLOCKS_PER_MESSAGE=4

# Idiomas de subtítulos a probar con yt-dlp, por orden de preferencia (separados por comas).
SUB_LANGS=en,en-US,en-GB
